{
  "manifest_version": 3,
  "name": "YTMusic Counter",
  "version": "1.0.0",
  "description": "Tracks and counts your played tracks and listening stats on YouTube Music.",
  "author": "r4pture-maik and antigravity/gemini",
  "browser_specific_settings": {
    "gecko": {
      "id": "ytmusic-counter@example.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YTMusic Counter",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
